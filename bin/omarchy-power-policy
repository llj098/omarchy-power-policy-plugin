#!/usr/bin/env python3
"""Event-driven AC/battery lid policy for Omarchy."""

from __future__ import annotations

import argparse
import logging
import signal
from dataclasses import dataclass
from typing import Final

_UNSET: Final = object()


@dataclass
class PolicyEngine:
    """Emit one suspend decision for each closed-lid-on-battery epoch."""

    on_battery: bool | None = None
    lid_closed: bool | None = None
    _unsafe_latched: bool = False

    def update(self, *, on_battery=_UNSET, lid_closed=_UNSET) -> bool:
        if on_battery is not _UNSET:
            self.on_battery = bool(on_battery)
        if lid_closed is not _UNSET:
            self.lid_closed = bool(lid_closed)

        unsafe = self.on_battery is True and self.lid_closed is True
        should_suspend = unsafe and not self._unsafe_latched
        self._unsafe_latched = unsafe
        return should_suspend


class PowerPolicyDaemon:
    UPOWER_NAME = "org.freedesktop.UPower"
    UPOWER_PATH = "/org/freedesktop/UPower"
    UPOWER_INTERFACE = "org.freedesktop.UPower"
    LOGIND_NAME = "org.freedesktop.login1"
    LOGIND_PATH = "/org/freedesktop/login1"
    LOGIND_INTERFACE = "org.freedesktop.login1.Manager"

    def __init__(self, *, dry_run: bool = False) -> None:
        import gi

        gi.require_version("Gio", "2.0")
        gi.require_version("GLib", "2.0")
        from gi.repository import Gio, GLib

        self.Gio = Gio
        self.GLib = GLib
        self.dry_run = dry_run
        self.engine = PolicyEngine()
        self.last_observed: tuple[bool, bool] | None = None
        self.loop = GLib.MainLoop()
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.upower = Gio.DBusProxy.new_sync(
            self.bus,
            Gio.DBusProxyFlags.NONE,
            None,
            self.UPOWER_NAME,
            self.UPOWER_PATH,
            self.UPOWER_INTERFACE,
            None,
        )
        self.logind = Gio.DBusProxy.new_sync(
            self.bus,
            Gio.DBusProxyFlags.NONE,
            None,
            self.LOGIND_NAME,
            self.LOGIND_PATH,
            self.LOGIND_INTERFACE,
            None,
        )
        self.upower.connect("g-properties-changed", self._on_properties_changed)
        self.upower.connect("notify::g-name-owner", self._on_name_owner_changed)

    def _property_bool(self, name: str) -> bool | None:
        value = self.upower.get_cached_property(name)
        if value is None:
            logging.warning("UPower property unavailable: %s", name)
            return None
        return bool(value.unpack())

    def _refresh_policy(self, reason: str) -> None:
        on_battery = self._property_bool("OnBattery")
        lid_closed = self._property_bool("LidIsClosed")
        if on_battery is None or lid_closed is None:
            return

        observed = (on_battery, lid_closed)
        if observed != self.last_observed:
            logging.info(
                "state reason=%s on_battery=%s lid_closed=%s",
                reason,
                on_battery,
                lid_closed,
            )
            self.last_observed = observed

        if self.engine.update(on_battery=on_battery, lid_closed=lid_closed):
            self._request_suspend(reason)

    def _request_suspend(self, reason: str) -> None:
        if self.dry_run:
            logging.warning("dry-run suspend reason=%s", reason)
            return

        logging.warning("requesting suspend reason=%s", reason)
        self.logind.call_sync(
            "Suspend",
            self.GLib.Variant("(b)", (False,)),
            self.Gio.DBusCallFlags.NONE,
            30_000,
            None,
        )

    def _on_properties_changed(self, _proxy, changed, invalidated) -> None:
        names = set(changed.unpack()) | set(invalidated)
        relevant = names.intersection({"OnBattery", "LidIsClosed"})
        if relevant:
            self._refresh_policy("upower:" + ",".join(sorted(relevant)))

    def _on_name_owner_changed(self, proxy, _pspec) -> None:
        if proxy.get_name_owner():
            self._refresh_policy("upower-owner")

    def run(self) -> None:
        self._refresh_policy("startup")
        signal.signal(signal.SIGTERM, lambda *_args: self.loop.quit())
        signal.signal(signal.SIGINT, lambda *_args: self.loop.quit())
        self.loop.run()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="observe policy decisions without requesting suspend",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    daemon = PowerPolicyDaemon(dry_run=args.dry_run)
    daemon.run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
