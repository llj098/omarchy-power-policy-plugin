[Unit]
Description=Omarchy AC/battery lid policy
PartOf=graphical-session.target
After=graphical-session.target
ConditionFileIsExecutable=%h/.config/omarchy/plugins/fatlj.power-policy/bin/omarchy-power-policy

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/fatlj.power-policy/bin/omarchy-power-policy
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
